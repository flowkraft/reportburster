      {
        "id": "w-dd25-chart-category-share-here-vs-everyone",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 4
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "order_lines",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "WITH per_category AS (\n  SELECT pr.category AS category,\n         sum(CASE WHEN g.country = ${country} THEN l.line_amount ELSE 0 END) AS here,\n         sum(l.line_amount) AS everywhere\n  FROM dash_demo.order_lines l\n  JOIN dash_demo.orders o ON o.order_id = l.order_id\n  JOIN dash_demo.geo_cities g ON g.city_id = o.city_id\n  JOIN dash_demo.products pr ON pr.product_id = l.product_id\n  WHERE o.status <> 'cancelled'\n  GROUP BY pr.category\n)\nSELECT c.category AS category,\n       round(100.0 * c.here / sum(c.here) OVER (), 2) AS share_here_pct,\n       round(100.0 * c.everywhere / sum(c.everywhere) OVER (), 2) AS share_everywhere_pct\nFROM per_category c\nORDER BY share_here_pct DESC",
          "executeVersion": 1
        },
        "displayConfig": {
          "dslConfig": {
            "type": "bar",
            "data": {
              "labelField": "category",
              "datasets": [
