      {
        "id": "w-dd25-chart-quarterly-index",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 8,
          "w": 8,
          "h": 4
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "orders",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "WITH per_quarter AS (\n  SELECT date_trunc('quarter', o.order_ts)::DATE AS quarter,\n         sum(CASE WHEN g.country = ${country} THEN o.total_amount ELSE 0 END) AS here,\n         sum(o.total_amount) AS everywhere\n  FROM dash_demo.orders o\n  JOIN dash_demo.geo_cities g ON g.city_id = o.city_id\n  WHERE o.status <> 'cancelled'\n  GROUP BY quarter\n)\nSELECT q.quarter AS quarter,\n       round(100.0 * q.here / first_value(q.here) OVER (ORDER BY q.quarter), 2) AS index_here,\n       round(100.0 * q.everywhere / first_value(q.everywhere) OVER (ORDER BY q.quarter), 2) AS index_everywhere\nFROM per_quarter q\nORDER BY q.quarter",
          "executeVersion": 1
        },
        "displayConfig": {
